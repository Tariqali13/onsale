# API (apps/api). Every variable is validated at startup; see apps/api/src/config.ts.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/onsale
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=
PAYMENT_PROVIDER=mock
# STRIPE_SECRET_KEY=sk_test_...   (test mode only; live keys are refused)
ADMIT_RATE_PER_SEC=25
MAX_ACTIVE_SESSIONS=400
HOLD_TTL_SEC=300
ENABLE_SIMULATOR=true
RATE_LIMIT_STORE=redis
# ADMIN_TOKEN=   (enables admin reset at any time)

# Web (apps/web)
VITE_API_URL=http://localhost:4000
